# openrouter-agent-bench environment configuration.
# Copy to `.env` and fill in real values:  cp .env.example .env
# Loaded automatically by tests and the web server (existing process env
# variables always take precedence over .env values).

# --- OpenRouter API (client + playground) ---
# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional. Override the OpenRouter API base URL (e.g. for a mock/proxy server
# when testing without hitting the real API).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Harness paths ---
# Optional. Root directory containing benchmark task suites
# (defaults to <repo>/tasks/suites).
OAB_SUITES_DIR=
# Optional. Path to the model catalog YAML (defaults to <repo>/models.yaml).
OAB_MODELS_FILE=

# --- Web frontend / server ---
OAB_SERVER_HOST=127.0.0.1
OAB_SERVER_PORT=8420

# --- Testing ---
# When set to "1", tests skip live-API checks and use offline fixtures only.
OAB_TESTING=1

# --- Free-tier restriction ---
# When "1" (the default), model listing and chat requests are restricted to
# free models (``:free`` ids / zero-cost pricing). Set to "0" to allow paid
# models.
OAB_FREE_MODELS_ONLY=1
